{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operations.schema.json",
  "title": "Canonical operation union",
  "description": "Explicit operation union, not a JSON Patch interpreter. Omission preserves; null clears only the schema-defined nullable properties; nested patches merge supplied leaves; arrays replace atomically.",
  "$ref": "#/$defs/Operation",
  "$defs": {
    "Target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "UUID, page-scoped alias, or exact display name; ambiguity is an error, never a guess."
    },
    "Delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xPt",
        "yPt"
      ],
      "properties": {
        "xPt": {
          "type": "number"
        },
        "yPt": {
          "type": "number"
        }
      }
    },
    "Pivot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xPt",
        "yPt"
      ],
      "properties": {
        "xPt": {
          "type": "number"
        },
        "yPt": {
          "type": "number"
        }
      }
    },
    "BoundsPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "TextBlockPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 65536
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fontSizePt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "colour": {
          "$ref": "document.schema.json#/$defs/Colour"
        },
        "horizontalAlign": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "verticalAlign": {
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "wrap": {
          "type": "boolean"
        },
        "paddingPt": {
          "type": "number",
          "minimum": 0
        },
        "insetsPt": {
          "description": "per-side text margins in points; a missing side keeps its current value; null returns to the uniform paddingPt",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "top": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                },
                "right": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                },
                "bottom": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                },
                "left": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2000
                }
              }
            }
          ]
        },
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        }
      }
    },
    "StylePatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Union of shape and connector style leaves; leaves that do not apply to the target's kind are rejected.",
      "properties": {
        "fill": {
          "$ref": "document.schema.json#/$defs/Paint"
        },
        "stroke": {
          "$ref": "document.schema.json#/$defs/Paint"
        },
        "strokeWidthPt": {
          "type": "number",
          "minimum": 0
        },
        "dash": {
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "dash-dot"
          ]
        },
        "lineCap": {
          "enum": [
            "butt",
            "round",
            "square"
          ]
        },
        "lineJoin": {
          "enum": [
            "miter",
            "round",
            "bevel"
          ]
        },
        "colour": {
          "$ref": "document.schema.json#/$defs/Colour"
        },
        "widthPt": {
          "type": "number",
          "minimum": 0
        },
        "startArrow": {
          "enum": [
            "none",
            "block",
            "open",
            "diamond",
            "oval"
          ]
        },
        "endArrow": {
          "enum": [
            "none",
            "block",
            "open",
            "diamond",
            "oval"
          ]
        },
        "startArrowSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "endArrowSize": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        }
      }
    },
    "GeometryPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "preset": {
          "enum": [
            "rectangle",
            "rounded-rectangle",
            "ellipse",
            "diamond",
            "triangle",
            "hexagon",
            "parallelogram",
            "cylinder",
            "cloud",
            "callout",
            "terminator",
            "stored-data",
            "document",
            "lined-document"
          ]
        },
        "svgPath": {
          "type": "string",
          "maxLength": 65536
        },
        "cornerRadiusPt": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ElementPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "alias": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "locked": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "layerIds": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Uuid"
          },
          "uniqueItems": true
        },
        "level": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127,
          "description": "R29. Stacking level; 0 clears the explicit level."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "style": {
          "$ref": "#/$defs/StylePatch"
        },
        "text": {
          "$ref": "#/$defs/TextBlockPatch"
        },
        "geometry": {
          "$ref": "#/$defs/GeometryPatch"
        },
        "routingPolicy": { "$ref": "document.schema.json#/$defs/ConnectorRoutingPolicy" },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "stretch"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "preserveAspectRatio": {
          "type": "boolean"
        },
        "route": {
          "enum": [
            "straight",
            "orthogonal",
            "curved"
          ]
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Point"
          },
          "maxItems": 256
        },
        "from": {
          "$ref": "#/$defs/EndpointInput"
        },
        "to": {
          "$ref": "#/$defs/EndpointInput"
        },
        "hops": {
          "enum": [
            "none",
            "arc"
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Port"
          },
          "maxItems": 64
        },
        "attachment": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "connector"
          ],
          "description": "null detaches the element and leaves it where it is",
          "properties": {
            "connector": {
              "$ref": "#/$defs/Target"
            },
            "position": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "offsetPt": {
              "type": "number",
              "minimum": -2000,
              "maximum": 2000
            }
          }
        },
        "labelAnchor": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "null returns the label to the middle of the line",
          "properties": {
            "position": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "offsetPt": {
              "type": "number",
              "minimum": -2000,
              "maximum": 2000
            }
          }
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "description": "Route mode of an orthogonal connector. automatic: the router chooses and remembers the route (also clears waypoints). manual: keep the route as drawn now as waypoints. frozen: keep the route as drawn now and never replace it. guided is reserved (R21) and refused.",
          "properties": {
            "mode": {
              "enum": [
                "automatic",
                "manual",
                "frozen",
                "guided"
              ]
            }
          }
        }
      }
    },
    "CreateShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "bounds"
      ],
      "properties": {
        "op": {
          "const": "createShape"
        },
        "id": {
          "$ref": "document.schema.json#/$defs/Uuid"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "pageId": {
          "$ref": "document.schema.json#/$defs/Uuid"
        },
        "layerIds": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Uuid"
          },
          "uniqueItems": true
        },
        "level": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127,
          "description": "R29. Stacking level; absent defaults to 0."
        },
        "bounds": {
          "$ref": "document.schema.json#/$defs/Bounds"
        },
        "rotationDeg": {
          "type": "number"
        },
        "geometry": {
          "$ref": "#/$defs/GeometryPatch"
        },
        "style": {
          "$ref": "#/$defs/StylePatch"
        },
        "text": {
          "$ref": "#/$defs/TextBlockPatch"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Port"
          },
          "maxItems": 64
        },
        "attachment": {
          "$ref": "#/$defs/AttachmentInput"
        }
      }
    },
    "CreateText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "bounds",
        "text"
      ],
      "properties": {
        "op": {
          "const": "createText"
        },
        "id": {
          "$ref": "document.schema.json#/$defs/Uuid"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "pageId": {
          "$ref": "document.schema.json#/$defs/Uuid"
        },
        "layerIds": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Uuid"
          },
          "uniqueItems": true
        },
        "level": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127,
          "description": "R29. Stacking level; absent defaults to 0."
        },
        "bounds": {
          "$ref": "document.schema.json#/$defs/Bounds"
        },
        "rotationDeg": {
          "type": "number"
        },
        "text": {
          "$ref": "#/$defs/TextBlockPatch"
        },
        "attachment": {
          "$ref": "#/$defs/AttachmentInput"
        }
      }
    },
    "CreateImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "bounds",
        "assetId"
      ],
      "properties": {
        "op": {
          "const": "createImage"
        },
        "id": {
          "$ref": "document.schema.json#/$defs/Uuid"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "pageId": {
          "$ref": "document.schema.json#/$defs/Uuid"
        },
        "layerIds": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Uuid"
          },
          "uniqueItems": true
        },
        "level": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127,
          "description": "R29. Stacking level; absent defaults to 0."
        },
        "bounds": {
          "$ref": "document.schema.json#/$defs/Bounds"
        },
        "rotationDeg": {
          "type": "number"
        },
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fit": {
          "enum": [
            "contain",
            "cover",
            "stretch"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "preserveAspectRatio": {
          "type": "boolean"
        }
      }
    },
    "CreateConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "from",
        "to"
      ],
      "properties": {
        "op": {
          "const": "createConnector"
        },
        "id": {
          "$ref": "document.schema.json#/$defs/Uuid"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "pageId": {
          "$ref": "document.schema.json#/$defs/Uuid"
        },
        "layerIds": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Uuid"
          },
          "uniqueItems": true
        },
        "level": {
          "type": "integer",
          "minimum": -127,
          "maximum": 127,
          "description": "R29. Stacking level; absent defaults to the start element's level."
        },
        "from": {
          "$ref": "#/$defs/EndpointInput"
        },
        "to": {
          "$ref": "#/$defs/EndpointInput"
        },
        "route": {
          "enum": [
            "straight",
            "orthogonal",
            "curved"
          ]
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "document.schema.json#/$defs/Point"
          },
          "maxItems": 256
        },
        "style": {
          "$ref": "#/$defs/StylePatch"
        },
        "label": {
          "$ref": "#/$defs/TextBlockPatch"
        },
        "labelAnchor": {
          "$ref": "#/$defs/LabelAnchorInput"
        },
        "hops": {
          "enum": [
            "none",
            "arc"
          ]
        },
        "routing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "description": "Route mode of an orthogonal connector. automatic: the router chooses and remembers the route (also clears waypoints). manual: keep the route as drawn now as waypoints. frozen: keep the route as drawn now and never replace it. guided is reserved (R21) and refused.",
          "properties": {
            "mode": {
              "enum": [
                "automatic",
                "manual",
                "frozen",
                "guided"
              ]
            }
          }
        }
      }
    },
    "AttachmentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector"
      ],
      "description": "Pins the element's centre to a place along a connector's route. connector is a Target resolved on the same page, including a connector created earlier in the batch.",
      "properties": {
        "connector": {
          "$ref": "#/$defs/Target"
        },
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "fraction of the route's length from its start; default 0.5"
        },
        "offsetPt": {
          "type": "number",
          "minimum": -2000,
          "maximum": 2000,
          "description": "distance to the right of the direction of travel; default 0"
        }
      }
    },
    "LabelAnchorInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "fraction of the route's length from its start; default 0.5"
        },
        "offsetPt": {
          "type": "number",
          "minimum": -2000,
          "maximum": 2000,
          "description": "distance to the right of the direction of travel; default 0 (on the line)"
        }
      }
    },
    "EndpointInput": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "if": { "required": ["requiredSide"], "properties": { "requiredSide": { "type": "string" } } }, "then": { "required": ["elementId"], "properties": { "glue": { "enum": ["dynamic", "static"] } } } }],
      "required": [
        "glue"
      ],
      "description": "Like Endpoint, but elementId may be a Target (alias or name) that the engine resolves to a UUID, including elements created earlier in the same batch.",
      "properties": {
        "elementId": {
          "$ref": "#/$defs/Target"
        },
        "port": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "point": {
          "$ref": "document.schema.json#/$defs/Point"
        },
        "glue": {
          "enum": [
            "dynamic",
            "static",
            "none"
          ]
        },        "preferredSide": {
          "type": ["string", "null"],
          "enum": ["north", "east", "south", "west", null],
          "description": "R22. Shape-local soft preference for a dynamic endpoint; null clears the preference."
        },
        "requiredSide": {
          "type": ["string", "null"],
          "enum": ["north", "east", "south", "west", null],
          "description": "R24. Required shape-local side for this endpoint; null clears the constraint."
        },
        "join": {
          "$ref": "#/$defs/JoinInput"
        }
      }
    },
    "JoinInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector"
      ],
      "description": "Makes the end a branch that joins another connector. glue must be none and there is no point: the end sits on the connector's route at position (0 to 1 of its length from the start; default 0.5) and follows it. connector is a Target on the same page, including one created earlier in the batch.",
      "properties": {
        "connector": {
          "$ref": "#/$defs/Target"
        },
        "position": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target",
        "patch"
      ],
      "properties": {
        "op": {
          "const": "set"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "patch": {
          "$ref": "#/$defs/ElementPatch"
        }
      }
    },
    "Move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target",
        "delta"
      ],
      "properties": {
        "op": {
          "const": "move"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "delta": {
          "$ref": "#/$defs/Delta"
        }
      }
    },
    "Resize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target",
        "bounds"
      ],
      "properties": {
        "op": {
          "const": "resize"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "bounds": {
          "$ref": "#/$defs/BoundsPatch"
        }
      }
    },
    "Rotate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target"
      ],
      "properties": {
        "op": {
          "const": "rotate"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "angleDeg": {
          "type": "number"
        },
        "deltaDeg": {
          "type": "number"
        },
        "pivot": {
          "$ref": "#/$defs/Pivot"
        }
      },
      "oneOf": [
        {
          "required": [
            "angleDeg"
          ]
        },
        {
          "required": [
            "deltaDeg"
          ]
        }
      ]
    },
    "Delete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "target"
      ],
      "properties": {
        "op": {
          "const": "delete"
        },
        "target": {
          "$ref": "#/$defs/Target"
        },
        "withConnectors": {
          "type": "boolean",
          "description": "Also delete connectors attached to the target; otherwise attached connectors are a dependency_conflict."
        },
        "children": {
          "enum": [
            "delete",
            "ungroup"
          ],
          "description": "Required when the target is a group: delete the whole subtree or keep the members (ungroup first)."
        }
      }
    },
    "RegisterAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "asset"
      ],
      "properties": {
        "op": {
          "const": "registerAsset"
        },
        "asset": {
          "$ref": "document.schema.json#/$defs/Asset"
        }
      }
    },
    "GridPatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "visible": {
          "type": "boolean"
        },
        "spacingPt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "snap": {
          "type": "boolean"
        }
      }
    },
    "PagePatch": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "widthPt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 14400
        },
        "heightPt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 14400
        },
        "background": {
          "$ref": "document.schema.json#/$defs/Paint"
        },
        "grid": {
          "$ref": "#/$defs/GridPatch"
        },
        "guides": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "document.schema.json#/$defs/Guide"
          }
        }
      }
    },
    "SetPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "patch"
      ],
      "properties": {
        "op": {
