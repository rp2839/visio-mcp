        },
        "as": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Alias of the copy; only valid for a single target."
        },
        "offset": {
          "$ref": "#/$defs/Delta"
        },
        "keepExternalLinks": {
          "type": "boolean",
          "description": "Copied connectors that attach to elements outside the duplicated set keep pointing at them; otherwise such connectors are not copied."
        },
        "keepAliases": {
          "type": "boolean",
          "description": "Copies keep their source's alias, made unique on the page by a numeric suffix (a, a-2, a-3); otherwise copies have no alias. Ignored for the copy named by as."
        },
        "id": {
          "$ref": "document.schema.json#/$defs/Uuid",
          "description": "UUID of the copy; only valid for a single target."
        }
      }
