<Window x:Class="WebViewProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WebView2 probe" Width="1000" Height="720">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
      <Button x:Name="MoveButton" Content="Agent: move rectangle +40pt" Click="OnMoveClick" Margin="0,0,8,0" />
      <TextBlock x:Name="Status" VerticalAlignment="Center" />
    </StackPanel>
    <wv2:WebView2 x:Name="View" />
  </DockPanel>
</Window>
