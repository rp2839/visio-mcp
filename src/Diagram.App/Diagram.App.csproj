<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Diagram.App</AssemblyName>
    <!-- Server GC (with .NET's dynamic adaptation) more than halves VSDX export/import time on
         5000-element drawings by cutting allocation stalls; see docs/acceptance/performance.md. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Diagram.Host.Core/Diagram.Host.Core.csproj" />
    <ProjectReference Include="../Diagram.Ipc/Diagram.Ipc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Packaged frontend (npm run build in src/web) served from the fixed virtual origin. -->
    <None Include="../web/dist/**" LinkBase="frontend" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../web/dist/index.html')" />
  </ItemGroup>
</Project>
