<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Diagram.App</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Diagram.Host.Core/Diagram.Host.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Packaged frontend (npm run build in src/web) served from the fixed virtual origin. -->
    <None Include="../web/dist/**" LinkBase="frontend" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../web/dist/index.html')" />
  </ItemGroup>
</Project>
